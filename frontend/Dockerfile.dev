FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Source code is mounted as a volume (hot-reload via vite)
# COPY . .  ← skipped intentionally; mounted in docker-compose.dev.yml

EXPOSE 5173

# Start Vite dev server, binding to 0.0.0.0 so it's reachable from host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
